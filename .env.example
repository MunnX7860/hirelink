# HireLink — environment template (docs/12 §2). Copy to `.env.local` and fill values.
# Everything below is validated at boot by src/lib/env.ts — boot fails fast if required vars are missing.
# NEVER commit .env.local or real secrets (docs/14 §6).

# --- Required ---
# App's own URL. Used for links in emails/Telegram and OAuth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase project (local: `supabase start` -> http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — restricted usage (docs/14 §5).
SUPABASE_SERVICE_ROLE_KEY=
# 64 hex chars (32 bytes). Encrypts user credentials at rest (docs/00 D3). Generate: openssl rand -hex 32
ENCRYPTION_SECRET=

# --- Optional / later phases ---
# Google Drive OAuth (docs/07, Phase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email via Resend (docs/09). Absent => simulated transport (render+log).
RESEND_API_KEY=
EMAIL_FROM="HireLink <notifications@example.com>"
# Rate limiting via Upstash (docs/05 §3). Absent => limits disabled (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Error tracking (optional, env-gated)
SENTRY_DSN=
# Guards /api/cron/* (Phase 2)
CRON_SECRET=
